{
  "app_name": "AI Website Health Orchestrator",
  "runtime_environment": "local",
  "development_tenant_id": "local-development",
  "guardrail_policy_version": "guardrails-v0.1",
  "data_dir": ".data",
  "database_filename": "orca.sqlite3",
  "artifact_directory": "artifacts",
  "max_pages": 10,
  "max_pages_ceiling": 50,
  "max_depth": 2,
  "max_depth_ceiling": 4,
  "run_timeout_seconds": 900,
  "max_retries_per_operation": 2,
  "retry_base_delay_ms": 500,
  "retry_max_delay_ms": 5000,
  "retry_jitter_ratio": 0.2,
  "max_url_length_bytes": 2048,
  "max_discovered_urls": 200,
  "max_agent_tasks_in_flight_per_run": 8,
  "page_navigation_timeout_seconds": 30,
  "http_probe_timeout_seconds": 10,
  "max_dom_chars": 200000,
  "max_html_fetch_bytes": 500000,
  "allowed_target_ports": [80, 443],
  "denied_target_domains": [],
  "denied_path_prefixes": [
    "/logout",
    "/delete",
    "/admin",
    "/account",
    "/cart",
    "/checkout"
  ],
  "tracking_query_parameters": ["utm_source", "utm_medium", "utm_campaign", "gclid"],
  "secret_mask_patterns": [
    "(?i)(api[_-]?key\\s*[=:]\\s*)([A-Za-z0-9_\\-]{8,})",
    "(?i)(authorization\\s*:\\s*bearer\\s+)([A-Za-z0-9\\-_\\.]+)",
    "(?i)(password\\s*[=:]\\s*)(\\S+)"
  ],
  "psi_enabled": false,
  "performance_thresholds": {
    "largest_contentful_paint": 2500,
    "total_blocking_time": 200
  },
  "latency_thresholds_ms": {
    "ttfb": 800,
    "document": 3000
  },
  "resource_limits": {
    "pages": 50,
    "browser_minutes": 20,
    "lighthouse_calls": 10,
    "psi_calls": 10,
    "http_probes": 250,
    "screenshots": 20,
    "llm_calls": 10,
    "llm_tokens": 50000,
    "artifact_bytes": 104857600
  },
  "log_level": "INFO"
}
