# Copy to .env and run: docker compose up -d
# Then start the API with RUNTIME_ENVIRONMENT=docker

RUNTIME_ENVIRONMENT=docker
DEVELOPMENT_TENANT_ID=local-development
APP_DATA_DIR=.data
LOG_LEVEL=INFO

POSTGRES_DB=orca
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca_local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orca:orca_local_dev_only@localhost:5432/orca

MINIO_ROOT_USER=orca_minio
MINIO_ROOT_PASSWORD=orca_minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=orca-artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=orca_minio
S3_SECRET_ACCESS_KEY=orca_minio_dev_only
S3_REGION=us-east-1
