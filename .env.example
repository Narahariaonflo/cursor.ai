# Optional overrides for config/defaults.json
APP_CONFIG_FILE=config/defaults.json
APP_NAME=AI Website Health Orchestrator
RUNTIME_ENVIRONMENT=local
DEVELOPMENT_TENANT_ID=local-development
GUARDRAIL_POLICY_VERSION=guardrails-v0.1
APP_DATA_DIR=.data
MAX_PAGES=10
MAX_PAGES_CEILING=50
MAX_DEPTH=2
MAX_DEPTH_CEILING=4
RUN_TIMEOUT_SECONDS=900
MAX_RETRIES_PER_OPERATION=2
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=5000
RETRY_JITTER_RATIO=0.2
MAX_URL_LENGTH_BYTES=2048
MAX_DISCOVERED_URLS=200
MAX_AGENT_TASKS_IN_FLIGHT_PER_RUN=8
PAGE_NAVIGATION_TIMEOUT_SECONDS=30
HTTP_PROBE_TIMEOUT_SECONDS=10
MAX_DOM_CHARS=200000
MAX_HTML_FETCH_BYTES=500000
LOG_LEVEL=INFO

# Docker data plane (see docker-compose.yml and .env.docker.example)
# RUNTIME_ENVIRONMENT=docker
# DATABASE_URL=postgresql://orca:orca_local_dev_only@localhost:5432/orca
# S3_BUCKET=orca-artifacts
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=orca_minio
# S3_SECRET_ACCESS_KEY=orca_minio_dev_only
# S3_REGION=us-east-1

# Staging/production managed services
# DATABASE_URL=postgresql://user:pass@host:5432/orca
# S3_BUCKET=orca-artifacts
# S3_REGION=us-east-1
